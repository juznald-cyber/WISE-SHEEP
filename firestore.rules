rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite a anfitriones y jugadores leer y escribir en las salas y sus subcolecciones (players, answers)
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
